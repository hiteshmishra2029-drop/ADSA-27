#include<iostream>

using namespace std;

class node{
public:

int data;
Node* left;
Node* right;

Node(int value){

data=value;
left=NULL;
right=NULL;
}
};

Node* insert(Node* root,int value){
if(root==NULL){
return new Node(value);
}

if(value<root->data)
root->left=insert(root->left,value);

else
root->right=insert(root->right,value);

return root;
}

void preorder(Node* root){
if(root==NULL)
return;

cout<< root->data<<" ";
preorder(root->left);
preorder(root->right);
}

void postorder(Node* root){

if(root==NULL)
return;

postorder(root->left);
postorder(root->right);
cout<< root->data<<" ";
}
